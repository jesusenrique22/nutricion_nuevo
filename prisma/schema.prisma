// Esquema PostgreSQL — fuente de verdad relacional
// docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ──────────────────────────────────────────────
// ENUMS (Reglas de negocio a nivel de tipo)
// ──────────────────────────────────────────────

enum UserRole {
  ADMIN // Nutricionista
  PATIENT
}

enum ConsultationModality {
  ONLINE
  PRESENCIAL
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum AppointmentCancelledBy {
  PATIENT
  ADMIN
}

enum AppointmentFlow {
  INTAKE // Primera cita -> Anamnesis completa
  FOLLOW_UP // Cita de seguimiento
}

enum ResourceAccessStatus {
  PENDING
  GRANTED
  REFUNDED
}

enum CartItemType {
  RESOURCE
  APPOINTMENT
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
  REFUNDED
  FAILED
}

enum RefundStatus {
  NONE
  REQUESTED
  APPROVED
  DENIED
}

// ──────────────────────────────────────────────
// AUTENTICACIÓN Y USUARIOS
// ──────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String?
  name          String
  phone         String?
  role          UserRole  @default(PATIENT)
  emailVerified DateTime?
  image         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patientProfile PatientProfile?
  appointments   Appointment[]      @relation("PatientAppointments")
  purchases ResourcePurchase[]
  cartItems   CartItem[]
  weeklyPlans    PatientWeeklyPlan[] @relation("PatientWeeklyPlans")

  accounts Account[]
  sessions Session[]

  @@index([role])
}

model PatientProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  birthDate      DateTime?
  gender         String?
  height         Float?
  occupation     String?
  emergencyPhone String?

  // Flag clave para decidir Intake vs Follow-up (Módulo 1)
  hasCompletedIntake Boolean @default(false)
  hiddenFromAdminList Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  intakeForm   IntakeForm?
  measurements AnthropometryMeasurement[]
}

// ──────────────────────────────────────────────
// CATÁLOGO DE CONSULTAS (Módulo 1)
// ──────────────────────────────────────────────

model ConsultationType {
  id              String  @id @default(cuid())
  code            String  @unique
  name            String
  description     String?
  durationMinutes Int     @default(60)
  price           Decimal @db.Decimal(10, 2)

  allowsOnline     Boolean @default(true)
  allowsPresencial Boolean @default(true)
  morningOnly      Boolean @default(false)
  morningStart     String?
  morningEnd       String?

  isPublished Boolean @default(true)
  sortOrder   Int     @default(0)
  imageUrl    String?

  appointments Appointment[]
  cartItems    CartItem[]
}

// ──────────────────────────────────────────────
// AGENDAMIENTO (Módulo 2)
// ──────────────────────────────────────────────

model Appointment {
  id                 String               @id @default(cuid())
  patientId          String
  patient            User                 @relation("PatientAppointments", fields: [patientId], references: [id])
  consultationTypeId String
  consultationType   ConsultationType     @relation(fields: [consultationTypeId], references: [id])
  startTime          DateTime
  endTime            DateTime
  modality           ConsultationModality
  status             AppointmentStatus    @default(PENDING)
  flow               AppointmentFlow
  notes              String?
  reminderSentAt     DateTime?
  cancelledBy        AppointmentCancelledBy?
  cancelledAt        DateTime?

  payment Payment?

  followUpSubmission          FollowUpSubmission?
  anthropometryFormSubmission AnthropometryFormSubmission?
  nutritionFormSubmission     NutritionFormSubmission?
  trainingFormSubmission      TrainingFormSubmission?
  anthropometryMeasurement    AnthropometryMeasurement?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([startTime, endTime])
  @@index([patientId])
  @@index([status])
  @@index([consultationTypeId])
}

// ──────────────────────────────────────────────
// ANAMNESIS Y MEDICIONES (Módulo 1)
// ──────────────────────────────────────────────

model IntakeForm {
  id               String         @id @default(cuid())
  patientProfileId String         @unique
  patientProfile   PatientProfile @relation(fields: [patientProfileId], references: [id], onDelete: Cascade)

  medicalHistory   Json
  allergies        Json
  dietaryHabits    Json
  physicalActivity Json
  goals            String?
  supplementsUse   Json?
  extendedPayload  Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AnthropometryMeasurement {
  id               String         @id @default(cuid())
  patientProfileId String
  patientProfile   PatientProfile @relation(fields: [patientProfileId], references: [id], onDelete: Cascade)
  appointmentId    String?        @unique
  appointment      Appointment?   @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  measuredAt DateTime @default(now())
  weight     Float?
  bodyFatPct Float?
  muscleMass Float?
  waist      Float?
  hip        Float?
  rawData    Json?

  @@index([patientProfileId, measuredAt])
}

// Formulario rápido de seguimiento (vinculado a una cita FOLLOW_UP)
model FollowUpSubmission {
  id            String      @id @default(cuid())
  appointmentId String      @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  currentWeight Float?
  energyLevel   String? // baja | normal | alta
  adherence     String? // cómo siguió el plan
  symptoms      String?
  notes         String?

  extendedPayload Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Formulario pre-evaluación antropométrica (ActiveAnto — 5 páginas)
model AnthropometryFormSubmission {
  id            String      @id @default(cuid())
  appointmentId String      @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  consentAccepted Boolean @default(false)

  fullName             String?
  consultationReason   String?
  phone                String?
  gender               String?
  birthDate            DateTime?

  previousAnthropometry Boolean?
  dominantHand          String?
  dominantFoot          String?
  activityLevel         String?
  activityFrequency     String?
  sportsPracticed       String?

  reportAnalysisTypes Json // string[]
  mainObjective       String?
  evaluationFrequency String?
  reservedSlotNote      String?

  procedureQuestions String?

  extendedPayload Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Primera consulta nutricional (Anttova — 4 páginas)
model NutritionFormSubmission {
  id            String      @id @default(cuid())
  appointmentId String      @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  fullName   String?
  phone      String?
  gender     String?
  birthDate  DateTime?

  consultationReason    String?
  dietDescription       String?
  dietaryRestrictions   String?
  activityLevel         String?
  activityFrequency     String?
  sportsPracticed       String?

  reservedSlotNote      String?
  continuationPreference String?

  extendedPayload Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Formulario pre-evaluación entrenamiento (5 páginas — mismo protocolo evaluación)
model TrainingFormSubmission {
  id            String      @id @default(cuid())
  appointmentId String      @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  consentAccepted Boolean @default(false)

  fullName           String?
  consultationReason String?
  phone              String?
  gender             String?
  birthDate          DateTime?

  previousAnthropometry Boolean?
  dominantHand          String?
  dominantFoot          String?
  activityLevel         String?
  activityFrequency     String?
  sportsPracticed       String?

  reportAnalysisTypes Json // string[]
  mainObjective       String?
  evaluationFrequency String?
  reservedSlotNote    String?

  procedureQuestions String?

  extendedPayload Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ──────────────────────────────────────────────
// PAGOS / TRANSACCIONES
// ──────────────────────────────────────────────

model Payment {
  id              String        @id @default(cuid())
  appointmentId   String        @unique
  appointment     Appointment   @relation(fields: [appointmentId], references: [id])
  amount          Decimal       @db.Decimal(10, 2)
  advanceAmount   Decimal       @default(0) @db.Decimal(10, 2)
  remainderAmount Decimal       @default(0) @db.Decimal(10, 2)
  advancePercent  Int           @default(50)
  currency        String        @default("ARS")
  status          PaymentStatus @default(PENDING)
  advanceStatus   PaymentStatus @default(PENDING)
  remainderStatus PaymentStatus @default(PENDING)
  provider        String?       @default("manual")
  providerRef     String?
  adminNote       String?
  advanceNote     String?
  remainderNote   String?
  patientPaymentMethod    String?
  patientPaymentReference String?
  patientPaymentNote      String?
  patientPaymentProofUrls Json?
  paidAt          DateTime?
  advancePaidAt   DateTime?
  remainderPaidAt DateTime?
  refundStatus        RefundStatus @default(NONE)
  refundRequestedAt   DateTime?
  refundPatientNote   String?
  refundAdminNote     String?
  refundResolvedAt    DateTime?
  advanceInboxTrashedAt    DateTime?
  remainderInboxTrashedAt  DateTime?
  advanceInboxDismissedAt  DateTime?
  remainderInboxDismissedAt DateTime?
  createdAt       DateTime      @default(now())
}

// ──────────────────────────────────────────────
// E-RESOURCES / LIBRERÍA (Módulo 5)
// ──────────────────────────────────────────────

model Resource {
  id          String   @id @default(cuid())
  title       String
  description String?  @db.Text
  type        String // EBOOK | VIDEO | LINK | PACKAGE
  coverUrl    String?
  contentUrl  String? // PDF, archivo descargable
  videoUrl    String?
  linkUrl     String?
  body        String?  @db.Text
  price       Decimal  @db.Decimal(10, 2)
  currency    String   @default("ARS")
  isPublished Boolean  @default(false)
  category    String?
  sortOrder   Int      @default(0)

  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  purchases ResourcePurchase[]
  cartItems   CartItem[]
}

// ──────────────────────────────────────────────
// CMS — Contenido editable (Módulo personalización)
// ──────────────────────────────────────────────

model SiteContent {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String?
  data      Json
  updatedAt DateTime @updatedAt
}

model MediaAsset {
  id        String   @id @default(cuid())
  url       String
  fileId    String?
  mimeType  String
  fileName  String?
  folder    String   @default("site")
  provider  String
  ownerId   String?
  createdAt DateTime @default(now())

  @@index([folder, createdAt(sort: Desc)])
}

model FormTemplate {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  fields    Json
  version   Int      @default(1)
  isActive  Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

model PatientWeeklyPlan {
  id          String    @id @default(cuid())
  patientId   String
  patient     User      @relation("PatientWeeklyPlans", fields: [patientId], references: [id], onDelete: Cascade)
  title       String    @default("Plan semanal")
  weekLabel   String?
  imageUrl    String?
  notes       String?   @db.Text
  days        Json
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([patientId, isPublished])
}

model ResourcePurchase {
  id         String               @id @default(cuid())
  userId     String
  user       User                 @relation(fields: [userId], references: [id])
  resourceId String
  resource   Resource             @relation(fields: [resourceId], references: [id])
  pricePaid  Decimal              @db.Decimal(10, 2)
  status     ResourceAccessStatus @default(PENDING)
  adminNote  String?
  patientPaymentMethod    String?
  patientPaymentReference String?
  patientPaymentNote      String?
  patientPaymentProofUrls Json?
  grantedAt  DateTime?
  refundStatus        RefundStatus @default(NONE)
  refundRequestedAt   DateTime?
  refundPatientNote   String?
  refundAdminNote     String?
  refundResolvedAt    DateTime?
  inboxTrashedAt      DateTime?
  inboxDismissedAt    DateTime?
  createdAt  DateTime             @default(now())

  @@unique([userId, resourceId])
  @@index([status])
}

model CartItem {
  id                 String                @id @default(cuid())
  userId             String
  user               User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  type               CartItemType
  resourceId         String?
  resource           Resource?             @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  consultationTypeId String?
  consultationType   ConsultationType?     @relation(fields: [consultationTypeId], references: [id])
  appointmentStart   DateTime?
  modality           ConsultationModality?
  createdAt          DateTime              @default(now())

  @@unique([userId, resourceId])
  @@index([userId])
}

// ──────────────────────────────────────────────
// NextAuth (tablas estándar)
// ──────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
