{
  "name": "nutricion-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:kill": "node scripts/kill-dev-ports.mjs",
    "dev:clean": "rm -rf .next && node scripts/dev.mjs",
    "build": "node scripts/production-build.mjs",
    "build:local": "prisma generate && next build",
    "build:skip-migrate": "SKIP_MIGRATE=1 node scripts/production-build.mjs",
    "vercel-build": "pnpm run build",
    "check:edge": "node scripts/check-edge-boundaries.mjs",
    "check:sql": "node scripts/check-sql-safety.mjs",
    "check:smoke": "node scripts/smoke-production.mjs",
    "check:deploy": "node scripts/check-deploy.mjs",
    "check:env": "CHECK_PRODUCTION_ENV=1 tsx scripts/check-production-env.ts",
    "start": "next start",
    "db:generate": "node scripts/prisma-cli.mjs generate",
    "postinstall": "node scripts/ensure-database-env.mjs && node scripts/prisma-cli.mjs generate && node scripts/copy-pdf-worker.mjs && node scripts/prepare-hosting-config.mjs",
    "db:migrate": "node scripts/prisma-cli.mjs migrate dev",
    "db:deploy": "node scripts/prisma-cli.mjs migrate deploy",
    "db:deploy:ws": "node scripts/migrate-deploy-ws.mjs",
    "db:migrate-media-local": "node scripts/migrate-media-to-local.mjs",
    "media:restore": "node --env-file=.env scripts/media-restore-plan.mjs",
    "db:push": "node scripts/prisma-cli.mjs db push",
    "db:seed": "node scripts/prisma-cli.mjs generate && node scripts/prisma-cli.mjs db seed",
    "db:studio": "node scripts/prisma-cli.mjs studio",
    "db:check": "node scripts/check-db.mjs",
    "db:verify": "node scripts/check-db.mjs && node scripts/check-db-schema.mjs",
    "db:check:mongo": "node --env-file=.env scripts/check-mongo.mjs",
    "email:check": "tsx --env-file=.env scripts/check-smtp.ts",
    "socket": "tsx src/server/socket/server.ts",
    "reminders": "node scripts/reminders.mjs"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.2",
    "@napi-rs/canvas": "^1.0.0",
    "@neondatabase/serverless": "^1.1.0",
    "@prisma/adapter-neon": "^6.19.3",
    "@prisma/client": "^6.19.3",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "bcryptjs": "^3.0.3",
    "date-fns": "^4.4.0",
    "framer-motion": "^12.40.0",
    "googleapis": "^173.0.0",
    "mongodb": "^7.2.0",
    "next": "16.2.7",
    "next-auth": "^5.0.0-beta.31",
    "nodemailer": "^8.0.10",
    "pdfjs-dist": "^6.0.227",
    "react": "19.2.4",
    "react-big-calendar": "^1.20.0",
    "react-dom": "19.2.4",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "ws": "^8.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^19",
    "@types/react-big-calendar": "^1.16.3",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5"
  }
}
