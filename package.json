{
  "name": "nutricion-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:clean": "rm -rf .next && next dev",
    "build": "node scripts/vercel-build.mjs",
    "build:local": "prisma generate && next build",
    "build:skip-migrate": "SKIP_MIGRATE=1 node scripts/vercel-build.mjs",
    "vercel-build": "node scripts/vercel-build.mjs",
    "check:edge": "node scripts/check-edge-boundaries.mjs",
    "check:smoke": "node scripts/smoke-production.mjs",
    "check:deploy": "node scripts/check-deploy.mjs",
    "start": "next start",
    "db:generate": "prisma generate",
    "postinstall": "prisma generate && node scripts/copy-pdf-worker.mjs",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "prisma generate && prisma db seed",
    "db:studio": "prisma studio",
    "db:check": "node scripts/check-db.mjs",
    "db:check:mongo": "node --env-file=.env scripts/check-mongo.mjs",
    "email:check": "tsx --env-file=.env scripts/check-smtp.ts",
    "socket": "tsx src/server/socket/server.ts",
    "reminders": "node scripts/reminders.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.2",
    "@napi-rs/canvas": "^1.0.0",
    "@prisma/client": "^6.19.3",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "bcryptjs": "^3.0.3",
    "date-fns": "^4.4.0",
    "framer-motion": "^12.40.0",
    "googleapis": "^173.0.0",
    "mongodb": "^7.2.0",
    "next": "16.2.7",
    "next-auth": "^5.0.0-beta.31",
    "nodemailer": "^8.0.10",
    "pdfjs-dist": "^6.0.227",
    "react": "19.2.4",
    "react-big-calendar": "^1.20.0",
    "react-dom": "19.2.4",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^19",
    "@types/react-big-calendar": "^1.16.3",
    "@types/react-dom": "^19",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5"
  }
}
