# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
.swc/

# production
/build
/dist

# typescript
*.tsbuildinfo
next-env.d.ts

# env files (secrets — nunca subir)
.env*
!.env.example
.env.backup
.env.*.backup

# hosting — carpeta local generada al vincular proyecto con CLI del proveedor
.hosting-link/
.vercel/

# debug / logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# caches
.eslintcache
.turbo
node_modules/.cache/

# misc
.DS_Store
Thumbs.db
*.pem
*.tmp
_tmp_*
*.swp
*~

# IDE / editor
.vscode/
.idea/
.cursor/
.cursor/plans/

# handoff / notas locales de sesión
HANDOFF-CONTEXTO-CHAT.txt
*.handoff.txt
*.handoff.md

# assets de diseño (fuentes pesadas; en web se usa public/brand/)
Anttova-Diseños/
Anttova _ Brandbook/

# código archivado / backups locales (no forma parte del build)
/_archived/
/src/_archived/

# generado en postinstall (scripts/copy-pdf-worker.mjs)
/public/pdf/

# uploads generados en runtime
/public/uploads/*
/uploads/
!/public/uploads/site/
!/public/uploads/site/**

# prisma — bases locales de desarrollo
*.db
*.db-journal

# tests e2e (si se agregan)
/playwright-report/
/test-results/
