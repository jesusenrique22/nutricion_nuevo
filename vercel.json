{
  "buildCommand": "pnpm run vercel-build",
  "installCommand": "pnpm install",
  "framework": "nextjs",
  "crons": [
    { "path": "/api/cron/reminders",     "schedule": "0 12 * * *" },
    { "path": "/api/cron/exchange-rate", "schedule": "0 11 * * *" }
  ],

  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options",   "value": "nosniff" },
        { "key": "X-Frame-Options",           "value": "SAMEORIGIN" },
        { "key": "X-XSS-Protection",         "value": "1; mode=block" },
        { "key": "Referrer-Policy",           "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy",        "value": "camera=(), microphone=(), geolocation=(), payment=()" },
        { "key": "Cross-Origin-Opener-Policy","value": "same-origin" },
        { "key": "Cross-Origin-Resource-Policy","value": "same-site" },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; object-src 'none'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.google.com https://www.gstatic.com https://www.recaptcha.net; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://res.cloudinary.com; font-src 'self' data:; connect-src 'self' https://*.upstash.io wss: https://www.google.com https://www.recaptcha.net; frame-src 'self' https://www.google.com https://www.recaptcha.net; worker-src 'self' blob:; manifest-src 'self'; media-src 'self' blob:"
        }
      ]
    },
    {
      "source": "/_next/static/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],

  "firewall": {
    "rules": [
      {
        "name": "Block path traversal",
        "description": "Bloquea intentos de directory traversal",
        "active": true,
        "action": "deny",
        "conditionGroup": [
          {
            "conditions": [
              { "type": "path", "op": "re", "value": "\\.\\.(\\\\|/)|\\.\\." }
            ]
          }
        ]
      },
      {
        "name": "Block common attack patterns",
        "description": "Bloquea user-agents de herramientas de escaneo comunes",
        "active": true,
        "action": "deny",
        "conditionGroup": [
          {
            "conditions": [
              {
                "type": "user_agent",
                "op": "re",
                "value": "(?i)(sqlmap|nikto|nessus|masscan|zgrab|nuclei|dirbuster|gobuster|wfuzz|hydra|nmap|burpsuite|acunetix|openvas|w3af|havij|pangolin|jsql)"
              }
            ]
          }
        ]
      },
      {
        "name": "Block common exploit paths",
        "description": "Bloquea rutas de exploits conocidos (wp-admin, phpmyadmin, etc.)",
        "active": true,
        "action": "deny",
        "conditionGroup": [
          {
            "conditions": [
              {
                "type": "path",
                "op": "re",
                "value": "(?i)(\\.php$|\\.asp$|\\.aspx$|wp-admin|wp-login|phpmyadmin|\\./env|\\.git/config|xmlrpc\\.php|cgi-bin|\\.htaccess|shell\\.php|c99\\.php|r57\\.php)"
              }
            ]
          }
        ]
      }
    ]
  }
}
