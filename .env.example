# ── PostgreSQL (Neon en producción) ──
# Si falla P1001 / ECONNRESET: en Neon → Reset password → copia URL nueva aquí y en Vercel.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.region.aws.neon.tech/neondb?sslmode=require"

# ── MongoDB (Atlas en producción) ──
MONGODB_URI="mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?appName=BD"
MONGODB_DB="nutricion_chat"

# ── NextAuth ──
# Generar: openssl rand -base64 32
AUTH_SECRET=""
# Local: http://localhost:3000 | Prod: URL exacta del deploy (sin barra final)
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# ── Rate limiting (Upstash) — opcional ──
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ── reCAPTCHA v3 — anti-spam al agendar citas ──
# Consola clásica: https://www.google.com/recaptcha/admin (tipo v3, basada en puntuación)
NEXT_PUBLIC_RECAPTCHA_SITE=""
RECAPTCHA_SECRET=""
# Opcional Enterprise (Google Cloud): si completás ambas, se usa automáticamente
# RECAPTCHA_PROJECT_ID=""
# GOOGLE_CLOUD_API_KEY=""

# Las imágenes y archivos se guardan en MongoDB (GridFS).
# No se requiere Cloudinary ni otro servicio externo de almacenamiento.

# ── Socket.io (chat en vivo — servidor aparte en prod, ej. Railway) ──
NEXT_PUBLIC_SOCKET_URL="http://localhost:3001"
SOCKET_PORT="3001"
SOCKET_INTERNAL_SECRET=""

# ── Recordatorios (cron Vercel → /api/cron/reminders) ──
# Generar: openssl rand -hex 32
CRON_SECRET=""

# ── Email (SMTP) — ver docs/EMAIL.md ──
EMAIL_FROM="Anttova <consultas@tudominio.com>"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
