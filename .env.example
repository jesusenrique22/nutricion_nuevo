# ── Email (SMTP propio — sin servicios de pago tipo Resend/SendGrid) ──
# Ver docs/EMAIL.md para configurar Postfix en VPS o correo del dominio.

# Remitente visible (usá un email de TU dominio en producción)
EMAIL_FROM="Anttova <consultas@tudominio.com>"
# Opcional: respuestas van a la nutricionista
# EMAIL_REPLY_TO="anto@gmail.com"

# ── Perfil A: VPS con Postfix local (recomendado en producción, $0 extra) ──
# SMTP_HOST="127.0.0.1"
# SMTP_PORT="25"
# SMTP_SECURE="false"
# SMTP_REQUIRE_TLS="false"
# (sin SMTP_USER ni SMTP_PASS — relay local)

# ── Perfil B: Correo incluido en tu hosting (cPanel, DonWeb, Hostinger…) ──
# SMTP_HOST="mail.tudominio.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER="consultas@tudominio.com"
# SMTP_PASS="tu_contraseña_del_buzón"

# ── Perfil C: Gmail gratuito (dev o bajo volumen; contraseña de aplicación) ──
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER="tu@gmail.com"
# SMTP_PASS="xxxx xxxx xxxx xxxx"

SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""

# Solo si tu servidor SMTP usa certificado autofirmado (evitar en prod si podés)
# SMTP_TLS_REJECT_UNAUTHORIZED="false"

# ── Recordatorios (cron propio, sin servicios pagos) ──